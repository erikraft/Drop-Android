<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F02A3446"
                android:centerColor="#EA1C2637"
                android:endColor="#F0101724" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#20FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
